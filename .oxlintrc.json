{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": [
    "@shadcn/lint",
    "./scripts/oxlint-plugin-template.js",
    { "name": "tanstack-router", "specifier": "@tanstack/eslint-plugin-router" },
    { "name": "tanstack-query", "specifier": "@tanstack/eslint-plugin-query" },
    { "name": "testing-library", "specifier": "eslint-plugin-testing-library" },
    { "name": "playwright", "specifier": "eslint-plugin-playwright" }
  ],
  "settings": {
    "shadcn": {
      "note": "See docs/DESIGN.md for the design system and approved exceptions."
    }
  },
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "react",
    "vitest",
    "jsx-a11y",
    "promise",
    "node"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "rules": {
    "no-alert": "error",
    "no-console": "error",
    "no-debugger": "error",
    "eqeqeq": ["error", "always"],
    "no-var": "error",
    "prefer-const": "error",
    "import/no-cycle": "error",
    "react/react-in-jsx-scope": "off",
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",
    "import/exports-last": "off",
    "sort-imports": "off",
    "sort-keys": "off",
    "func-style": "off",
    "no-magic-numbers": "off",
    "no-ternary": "off",
    "vitest/no-importing-vitest-globals": "off",
    "vitest/prefer-describe-function-title": "off",
    "node/no-process-env": "error",
    "unicorn/prefer-node-protocol": "off",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",

    "unicorn/no-null": "off",

    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "typescript/consistent-type-imports": [
      "warn",
      { "prefer": "type-imports", "fixStyle": "separate-type-imports" }
    ],
    "typescript/no-unnecessary-condition": ["error", { "allowConstantLoopConditions": true }],
    "typescript/no-non-null-assertion": "error",
    "typescript/no-explicit-any": "warn",

    "import/no-duplicates": "error",
    "import/first": "error",
    "import/extensions": "off",
    "import/consistent-type-specifier-style": ["error", "prefer-top-level"],
    "no-underscore-dangle": ["error", { "allow": ["__dirname", "__appSentryInitialized__"] }],
    "no-restricted-imports": [
      "error",
      {
        "name": "zod/v3",
        "message": "Zod 3 is legacy. Use `import { z } from 'zod'` for Zod 4.5."
      }
    ],

    "shadcn/no-restyle": [
      "error",
      {
        "allow": ["layout"],
        "contracts": [{ "pattern": "^Skeleton$", "allow": ["layout", "rounded-full"] }]
      }
    ],
    "shadcn/no-raw-colors": "error",
    "shadcn/no-arbitrary-values": ["error", { "allow": ["layout"] }],
    "shadcn/no-inline-styles": "error",
    "shadcn/no-unknown-classes": "error",
    "shadcn/require-static-classes": "error",

    // Template house rules (scripts/oxlint-plugin-template.js): the structural checks that used to
    // be filesystem-scanning unit tests. Each rule scopes itself by path, so enabling one globally
    // costs one visit per file and nothing else.
    "template/bundle-no-server-imports": "error",
    "template/bundle-no-server-default-params": "error",
    "template/server-fn-requires-session": "error",
    "template/route-declaration-only": "error",
    "template/route-no-view-hooks": "error",
    "template/route-view-source": "error",

    // TanStack Router and Query. The query plugin's no-rest-destructuring and no-void-query-fn are
    // omitted: they need TypeScript type information, which oxlint cannot feed to JS plugins, so
    // they would silently pass everything.
    "tanstack-router/create-route-property-order": "warn",
    "tanstack-router/route-param-names": "error",
    "tanstack-query/exhaustive-deps": "error",
    "tanstack-query/stable-query-client": "error",
    "tanstack-query/no-unstable-deps": "error",
    "tanstack-query/infinite-query-property-order": "error",
    "tanstack-query/mutation-property-order": "error",
    "tanstack-query/prefer-query-options": "error"
  },
  "overrides": [
    {
      "files": ["tests/**", "instrument.server.mjs"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["src/env.ts", "playwright.config.ts", "instrument.server.mjs"],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    {
      "files": ["src/env.ts"],
      "rules": {
        "no-unnecessary-condition": "off"
      }
    },
    {
      "files": ["tests/**"],
      "rules": {
        "no-unnecessary-condition": "off",
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": [
        "src/features/auth/components/login-form.tsx",
        "src/features/auth/components/verify-otp.tsx",
        "src/features/auth/components/signup-form.tsx"
      ],
      "rules": {
        "no-base-to-string": "off"
      }
    },
    // Upstream components generated/copied from shadcn/ui and not maintained locally. The shadcn
    // checks that are off here need a component's internals, not its call sites: appearance and
    // the variant functions that own them. Token and inline-style checks still run.
    {
      "files": ["src/components/ui/**"],
      "rules": {
        "eqeqeq": "off",
        "no-shadow": "off",
        "no-underscore-dangle": "off",
        "import/consistent-type-specifier-style": "off",
        "jsx-a11y/anchor-has-content": "off",
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off",
        "jsx-a11y/prefer-tag-over-role": "off",
        "react/jsx-no-constructed-context-values": "off",
        "react/no-array-index-key": "off",
        "react/no-object-type-as-default-prop": "off",
        "react/no-unstable-nested-components": "off",
        "shadcn/no-arbitrary-values": "off",
        "shadcn/no-restyle": "off",
        "shadcn/require-static-classes": "off",
        "typescript/consistent-return": "off",
        "typescript/no-explicit-any": "off",
        "typescript/no-unnecessary-condition": "off",
        "typescript/no-unnecessary-type-assertion": "off",
        "typescript/no-unnecessary-type-conversion": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/restrict-template-expressions": "off"
      }
    },
    // React Email renders inline styles; email clients need them.
    {
      "files": ["src/features/emails/**"],
      "rules": {
        "shadcn/no-inline-styles": "off"
      }
    },
    // Upstream shadcn/ui internals the design system cannot verify: sonner and input-otp use
    // their own component-scoped classes, navigation-menu uses Base UI data variants and an
    // undefined `xs:` breakpoint, and chart injects per-series CSS variables at runtime.
    {
      "files": ["src/components/ui/sonner.tsx", "src/components/ui/input-otp.tsx"],
      "rules": {
        "shadcn/no-unknown-classes": ["error", { "allow": ["toaster", "cn-input-otp"] }]
      }
    },
    {
      "files": ["src/components/ui/navigation-menu.tsx"],
      "rules": {
        "shadcn/no-unknown-classes": "off"
      }
    },
    {
      "files": ["src/components/ui/chart.tsx"],
      "rules": {
        "shadcn/no-inline-styles": "off"
      }
    },
    // Testing Library's React recommended set, for the unit tests that render components.
    {
      "files": ["tests/unit/**"],
      "rules": {
        "testing-library/await-async-events": ["error", { "eventModule": "userEvent" }],
        "testing-library/await-async-queries": "error",
        "testing-library/await-async-utils": "error",
        "testing-library/no-await-sync-events": ["error", { "eventModules": ["fire-event"] }],
        "testing-library/no-await-sync-queries": "error",
        "testing-library/no-container": "error",
        "testing-library/no-debugging-utils": "warn",
        "testing-library/no-dom-import": ["error", "react"],
        "testing-library/no-global-regexp-flag-in-query": "error",
        "testing-library/no-manual-cleanup": "error",
        "testing-library/no-node-access": "error",
        "testing-library/no-promise-in-fire-event": "error",
        "testing-library/no-render-in-lifecycle": "error",
        "testing-library/no-unnecessary-act": "error",
        "testing-library/no-wait-for-multiple-assertions": "error",
        "testing-library/no-wait-for-side-effects": "error",
        "testing-library/no-wait-for-snapshot": "error",
        "testing-library/prefer-find-by": "error",
        "testing-library/prefer-presence-queries": "error",
        "testing-library/prefer-query-by-disappearance": "error",
        "testing-library/prefer-screen-queries": "error",
        "testing-library/render-result-naming-convention": "error"
      }
    },
    // Renders email HTML with @react-email/render, which is not Testing Library's `render`.
    {
      "files": ["tests/unit/email-templates.test.tsx"],
      "rules": {
        "testing-library/render-result-naming-convention": "off"
      }
    },
    // Playwright's recommended set, for the end-to-end suite.
    {
      "files": ["tests/e2e/**"],
      "rules": {
        "playwright/consistent-spacing-between-blocks": "warn",
        "playwright/expect-expect": "warn",
        "playwright/max-nested-describe": "warn",
        "playwright/missing-playwright-await": "error",
        "playwright/no-conditional-expect": "warn",
        "playwright/no-conditional-in-test": "warn",
        "playwright/no-duplicate-hooks": "warn",
        "playwright/no-duplicate-slow": "warn",
        "playwright/no-element-handle": "warn",
        "playwright/no-eval": "warn",
        "playwright/no-focused-test": "error",
        "playwright/no-force-option": "warn",
        "playwright/no-identical-title": "warn",
        "playwright/no-nested-step": "warn",
        "playwright/no-networkidle": "error",
        "playwright/no-page-pause": "warn",
        "playwright/no-skipped-test": "warn",
        "playwright/no-standalone-expect": "error",
        "playwright/no-unnecessary-assertions": "error",
        "playwright/no-unsafe-references": "error",
        "playwright/no-unused-locators": "error",
        "playwright/no-useless-await": "warn",
        "playwright/no-useless-not": "warn",
        "playwright/no-wait-for-navigation": "error",
        "playwright/no-wait-for-selector": "warn",
        "playwright/no-wait-for-timeout": "warn",
        "playwright/prefer-hooks-in-order": "warn",
        "playwright/prefer-hooks-on-top": "warn",
        "playwright/prefer-locator": "warn",
        "playwright/prefer-to-have-count": "warn",
        "playwright/prefer-to-have-length": "warn",
        "playwright/prefer-web-first-assertions": "error",
        "playwright/valid-describe-callback": "error",
        "playwright/valid-expect": "error",
        "playwright/valid-expect-in-promise": "error",
        "playwright/valid-test-tags": "error",
        "playwright/valid-title": "error"
      }
    }
  ],
  "env": {
    "builtin": true,
    "node": true,
    "browser": true
  },
  "ignorePatterns": [".output/**", ".nitro/**", "node_modules/**", "src/routeTree.gen.ts"]
}
