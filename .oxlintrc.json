{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["@shadcn/lint"],
  "settings": {
    "shadcn": {
      "note": "See docs/DESIGN.md for the design system and approved exceptions."
    }
  },
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "react",
    "vitest",
    "jsx-a11y",
    "promise",
    "node"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "rules": {
    "no-alert": "error",
    "no-console": "error",
    "no-debugger": "error",
    "eqeqeq": ["error", "always"],
    "no-var": "error",
    "prefer-const": "error",
    "import/no-cycle": "error",
    "react/react-in-jsx-scope": "off",
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",
    "import/exports-last": "off",
    "sort-imports": "off",
    "sort-keys": "off",
    "func-style": "off",
    "no-magic-numbers": "off",
    "no-ternary": "off",
    "vitest/no-importing-vitest-globals": "off",
    "vitest/prefer-describe-function-title": "off",
    "node/no-process-env": "error",
    "unicorn/prefer-node-protocol": "off",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",

    "unicorn/no-null": "off",

    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "typescript/consistent-type-imports": [
      "warn",
      { "prefer": "type-imports", "fixStyle": "separate-type-imports" }
    ],
    "typescript/no-unnecessary-condition": ["error", { "allowConstantLoopConditions": true }],
    "typescript/no-non-null-assertion": "error",
    "typescript/no-explicit-any": "warn",

    "import/no-duplicates": "error",
    "import/first": "error",
    "import/extensions": "off",
    "import/consistent-type-specifier-style": ["error", "prefer-top-level"],
    "no-underscore-dangle": ["error", { "allow": ["__dirname"] }],
    "no-restricted-imports": [
      "error",
      {
        "name": "zod/v3",
        "message": "Zod 3 is legacy. Use `import { z } from 'zod'` for Zod 4.5."
      }
    ],

    "shadcn/no-restyle": [
      "error",
      {
        "allow": ["layout"],
        "contracts": [{ "pattern": "^Skeleton$", "allow": ["layout", "rounded-full"] }]
      }
    ],
    "shadcn/no-raw-colors": "error",
    "shadcn/no-arbitrary-values": ["error", { "allow": ["layout"] }],
    "shadcn/no-inline-styles": "error",
    "shadcn/no-unknown-classes": "error",
    "shadcn/require-static-classes": "error"
  },
  "overrides": [
    {
      "files": ["tests/**"],
      "rules": {
        "no-console": "off",
        "typescript/no-unnecessary-condition": "off",
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["playwright.config.ts"],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    // Upstream components generated/copied from shadcn/ui and not maintained locally. The shadcn
    // checks that are off here need a component's internals, not its call sites: appearance and
    // the variant functions that own them. Token and inline-style checks still run.
    {
      "files": ["src/components/ui/**"],
      "rules": {
        "eqeqeq": "off",
        "no-shadow": "off",
        "no-underscore-dangle": "off",
        "import/consistent-type-specifier-style": "off",
        "jsx-a11y/anchor-has-content": "off",
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off",
        "jsx-a11y/prefer-tag-over-role": "off",
        "react/jsx-no-constructed-context-values": "off",
        "react/no-array-index-key": "off",
        "react/no-object-type-as-default-prop": "off",
        "react/no-unstable-nested-components": "off",
        "shadcn/no-arbitrary-values": "off",
        "shadcn/no-restyle": "off",
        "shadcn/require-static-classes": "off",
        "typescript/consistent-return": "off",
        "typescript/no-explicit-any": "off",
        "typescript/no-unnecessary-condition": "off",
        "typescript/no-unnecessary-type-assertion": "off",
        "typescript/no-unnecessary-type-conversion": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/restrict-template-expressions": "off"
      }
    },
    // Upstream shadcn/ui internals the design system cannot verify: sonner uses
    // its own component-scoped classes.
    {
      "files": ["src/components/ui/sonner.tsx"],
      "rules": {
        "shadcn/no-unknown-classes": ["error", { "allow": ["toaster"] }]
      }
    }
  ],
  "env": {
    "builtin": true,
    "node": true,
    "browser": true
  },
  "ignorePatterns": [
    ".output/**",
    ".nitro/**",
    ".tanstack/**",
    "test-results/**",
    "node_modules/**",
    "src/routeTree.gen.ts"
  ]
}
