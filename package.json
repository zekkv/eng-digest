{
  "name": "tanstack-start-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "clean": "bunx rimraf .output .vite node_modules .tanstack src/routeTree.gen.ts coverage test-results playwright-report",
    "dev": "bun --bun --import ./instrument.server.mjs vite dev --port 3000",
    "build": "bun --bun vite build && cp instrument.server.mjs .output/server/",
    "build:docker": "docker build -t tanstack-start-template .",
    "preview": "vite preview",
    "start": "bun --bun --import ./.output/server/instrument.server.mjs .output/server/index.mjs",
    "type:check": "bun check",
    "lint:check": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format:check": "bun fmt --check .",
    "format:fix": "bun fmt .",
    "auth:generate": "bunx auth@latest generate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:seed": "bun scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "codegen": "playwright codegen",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration --coverage.enabled=false",
    "test:e2e": "playwright test",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/passkey": "^1.7.10",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@logtape/logtape": "^2.4.1",
    "@logtape/sentry": "^2.4.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.1",
    "@sentry/tanstackstart-react": "^11.8.0",
    "@shadcn/react": "^0.3.1",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form-start": "^1.33.5",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.2",
    "@tanstack/react-table": "^9.3.1",
    "better-auth": "^1.7.10",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "1.58.0",
    "next-themes": "^0.4.6",
    "nitro": "^3.0.260903-beta",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.14.5",
    "recharts": "3.10.1",
    "resend": "^6.34.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@shadcn/lint": "^0.2.1",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/eslint-plugin-query": "^5.104.3",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-form-devtools": "^0.2.34",
    "@tanstack/react-query-devtools": "^5.104.3",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@testcontainers/postgresql": "^12.2.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "nodemailer": "^10.1.2",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "pg": "^8.23.1",
    "shadcn": "^4.22.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/instrumentation": "0.214.0",
    "esbuild": "^0.25.0"
  },
  "packageManager": "bun@1.4.4"
}
