{
  "name": "eng-digest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "clean": "bunx rimraf .output .vite node_modules .tanstack src/routeTree.gen.ts coverage test-results playwright-report",
    "dev": "bun --bun vite dev --port 3000",
    "build": "bun --bun vite build",
    "build:vercel": "bun --bun vite build --mode vercel",
    "deploy:vercel": "bun run build:vercel && bunx vercel deploy --prebuilt --prod",
    "start": "bun --bun ./.output/server/index.mjs",
    "type:check": "tsc --noEmit",
    "lint:check": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "digest:daily": "bun scripts/digest-daily.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/recursive": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/zilla-slab": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-start": "^1.168.49",
    "@upstash/redis": "^1.39.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "1.41.0",
    "next-themes": "^0.4.6",
    "nitro": "^3.0.260903-beta",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rss-parser": "^3.13.0",
    "sonner": "^2.0.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@shadcn/lint": "^0.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.4.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vercel": "^41.3.0",
    "vite": "^8.2.1",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  },
  "packageManager": "bun@1.4.2"
}
