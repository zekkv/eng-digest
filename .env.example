# Engineering digest backend (src/features/digest)
OPENROUTER_API_KEY="your-openrouter-api-key"
TAVILY_API_KEY="your-tavily-api-key"
# Optional model override (default: meta/muse-spark-1.3-contributor)
# DIGEST_MODEL="meta/muse-spark-1.3-contributor"
# Optional picks per daily run (default: 10)
# DIGEST_PICK_COUNT="10"
# Optional: set to 0 to skip DNS checks on fetched hosts (unit tests do this)
# DIGEST_DNS_CHECK="0"
# Upstash Redis cache (shared between the Vercel web app and the GitHub Actions
# daily digest workflow — the Vercel Marketplace integration injects these;
# Upstash's own UPSTASH_REDIS_REST_URL/UPSTASH_REDIS_REST_TOKEN names also work)
# KV_REST_API_URL="https://your-db.upstash.io"
# KV_REST_API_TOKEN="your-upstash-token"
