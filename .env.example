VITE_APP_TITLE="TanStack Start Template"
VITE_SENTRY_DSN="https://123456789.ingest.us.sentry.io/123456789"
VITE_SENTRY_ORG="your-sentry-org"
VITE_SENTRY_PROJECT="your-sentry-project"
SENTRY_AUTH_TOKEN="your-sentry-auth-token"

SERVER_URL="http://localhost:3000"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-32-character-secret"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="noreply@example.com"

# SMTP relay. When set, email bypasses Resend and goes through this server; used by local and
# E2E runs with a capture server (Mailpit on smtp://127.0.0.1:1025). Leave unset in production.
# SMTP_URL="smtp://127.0.0.1:1025"

# S3-compatible object storage
# Works with MinIO, S3, R2, or Supabase Storage
MINIO_ENDPOINT="http://localhost:9000"
MINIO_BUCKET="app"
MINIO_ACCESS_KEY="admin"
MINIO_SECRET_KEY="password"

# Redis session cache (optional — Bun native Redis client)
# REDIS_URL="redis://localhost:6379"
